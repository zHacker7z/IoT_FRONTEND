# Copie este arquivo para .env.local e preencha com os dados reais da API.
# Todas as variáveis VITE_ vão para o navegador: nunca coloque senhas, tokens ou chaves aqui.
# Depois de alterar, reinicie o `npm run dev` (ou gere o build de novo).

# URL-base da API do backend na VPS (obrigatória). Sem barra no final.
VITE_API_BASE_URL=

# Caminho do endpoint que devolve a medição mais recente (temperatura e umidade).
VITE_API_LATEST_PATH=

# Caminho do endpoint que devolve a lista de medições (histórico). Opcional.
# Se só ele for informado, a leitura atual passa a ser o ponto mais recente do histórico.
VITE_API_HISTORY_PATH=

# Tempo limite de cada requisição, em milissegundos. Padrão: 10000.
VITE_API_TIMEOUT_MS=10000

# Intervalo da atualização automática, em segundos. Ajuste à frequência de coleta do sensor. 0 desativa. Padrão: 60.
VITE_REFRESH_INTERVAL_SECONDS=60

# Idade máxima da última medição antes de ela ser considerada desatualizada, em minutos. Padrão: 15.
VITE_STALE_AFTER_MINUTES=15

# Opcional: nomes dos campos no JSON, caso o reconhecimento automático não os encontre.
# Aceitam caminho com ponto para campos aninhados (ex.: sensores.temperatura).
VITE_API_FIELD_TEMPERATURE=
VITE_API_FIELD_HUMIDITY=
VITE_API_FIELD_TIMESTAMP=
